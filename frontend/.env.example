# ─── BloomTech Frontend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# On Cloudflare Pages: set these under Settings → Environment Variables.

# Backend API URL — set to your Railway deployment URL in production
VITE_API_URL=https://YOUR_APP.up.railway.app

# Google OAuth — from Google Cloud Console → Credentials (same client ID as backend)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
