# ─── BloomTech Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# On Railway: set these in the service's Variables tab (DATABASE_URL is auto-set).

# Database — Railway auto-injects this when a Postgres plugin is attached
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_SECURE_64_BYTE_HEX_SECRET

# Google OAuth — from Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Server
PORT=5000
NODE_ENV=production
